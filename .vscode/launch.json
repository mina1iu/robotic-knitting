{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Calibration: left preview (no motion)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/calibration_test.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "left"
            ]
        },
        {
            "name": "Calibration: left EXECUTE (real motion)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/calibration_test.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "args": [
                "left",
                "--execute"
            ]
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}